{
  "name": "@paperclipai/plugin-company-os",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Company OS dev cockpit: an auto-updating Kanban (system x spec-prefix family) plus a docs/reports/routines viewer over the Lycaon multi-repo workspace. Read-only over product repos.",
  "files": [
    "dist",
    "migrations",
    "README.md"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "node ./esbuild.config.mjs",
    "dev": "node ./esbuild.config.mjs --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "e2e": "playwright test",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "company-os",
    "cockpit",
    "kanban"
  ],
  "author": "Lycaon",
  "license": "MIT",
  "devDependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.28.0",
    "react-dom": "^19.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
